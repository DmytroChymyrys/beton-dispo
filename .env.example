# ---------------------------------------------------------------------------
# BétonDispo — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, hreflang, sitemap, share previews
# and admin links inside notification emails. No trailing slash.
#
# Local development:
# NEXT_PUBLIC_SITE_URL=http://localhost:3987
#
# Production: choose ONE canonical domain. Other domains should redirect to it.
NEXT_PUBLIC_SITE_URL=https://betondispo.ca

# Optional GA4 measurement ID. Example: G-NHG2ZL55KG
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Database (Neon Postgres via the Vercel Marketplace) -------------------
# Vercel injects DATABASE_URL automatically once the Neon integration is
# connected to the project. For local development, copy the pooled connection
# string from the Neon dashboard (it ends with `-pooler`).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/betondispo?sslmode=require

# Direct (non-pooled) connection. Only needed for `drizzle-kit` migrations.
# Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# --- Transactional email (Resend) ------------------------------------------
RESEND_API_KEY=
# Verified sender for internal notifications.
QUOTE_NOTIFICATION_FROM="BétonDispo <notifications@betondispo.com>"
# Internal recipient(s) for new quote requests. Comma-separated for several.
QUOTE_NOTIFICATION_EMAIL=

# --- Anti-spam --------------------------------------------------------------
# Quote submissions allowed per IP per window. Defaults to 5 per 10 minutes.
# Raise it locally and in CI: an end-to-end run, a load test, or an office
# behind one NAT all look like a single client.
QUOTE_RATE_LIMIT=
QUOTE_RATE_LIMIT_WINDOW_MS=

# --- Internal admin ---------------------------------------------------------
# Email/username shown on the admin sign-in form.
ADMIN_EMAIL=
# Admin password. Use a long random value.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
